# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN APACHE PARA INFINITYFREE / CPANEL
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Pasar el Header Authorization a PHP en Apache/FastCGI (Crucial para Login y Admin)
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
</IfModule>

# Habilitar CORS
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-Authorization"
</IfModule>

# Configuración de límite de subida
php_value upload_max_filesize 10M
php_value post_max_size 10M

# ==============================================================================
# CABECERAS DE SEGURIDAD Y RENDIMIENTO (SEO)
# ==============================================================================

<IfModule mod_headers.c>
    # Evitar clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # Prevenir MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"
    # HSTS (solo si se usa HTTPS en producción)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Cache control para assets estáticos
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Cache control para HTML
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=600, must-revalidate"
    </FilesMatch>
</IfModule>

# Compresión Gzip/Brotli para recursos de texto
<IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>
